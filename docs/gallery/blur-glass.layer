<Layer width="1080" height="1180" background="#0a0e14" color="#f4f1ea" font-family="Kai">
  <Rect x1="0" y1="0" x2="1080" y2="1180" fill="linear-gradient(to bottom, #121826, #1a3348 45%, #243c38)" />
  <!-- 条纹只画一遍，三档玻璃看的是同一张背景 -->
  <Rect x1="0" y1="200" x2="1080" y2="216" fill="#ffffff" opacity="0.9" />
  <Rect x1="0" y1="260" x2="1080" y2="276" fill="#f5c16c" />
  <Rect x1="0" y1="320" x2="1080" y2="336" fill="#7b6cff" />
  <Rect x1="160" y1="160" x2="176" y2="360" fill="#ffffff" opacity="0.75" />
  <Rect x1="520" y1="160" x2="536" y2="360" fill="#ff9f1c" opacity="0.9" />
  <Rect x1="880" y1="160" x2="896" y2="360" fill="#3ecfc4" />

  <Rect x1="0" y1="620" x2="1080" y2="636" fill="#ffffff" opacity="0.9" />
  <Rect x1="0" y1="700" x2="1080" y2="716" fill="#ff9f1c" />
  <Rect x1="0" y1="780" x2="1080" y2="796" fill="#3ecfc4" />
  <Rect x1="0" y1="860" x2="1080" y2="876" fill="#ffffff" opacity="0.85" />
  <Rect x1="180" y1="560" x2="196" y2="900" fill="#ffffff" opacity="0.7" />
  <Rect x1="520" y1="560" x2="536" y2="900" fill="#ff5aa5" opacity="0.85" />
  <Rect x1="860" y1="560" x2="876" y2="900" fill="#f5c16c" />

  <Layer cx="64" cy="36" anchor="top-left">
    <h1 style="font-size:48px; color:#f7f2e8">模糊与玻璃</h1>
  </Layer>

  <Rect cx="200" cy="300" width="240" height="140" rx="20" fill="#f7931a" blur="6" />
  <Layer cx="200" cy="400" anchor="top"><p style="font-size:26px; color:#9aa7b5">blur</p></Layer>

  <Rect cx="540" cy="300" width="240" height="140" rx="20" fill="#ffffff22" backdrop-blur="16" />
  <Layer cx="540" cy="400" anchor="top"><p style="font-size:26px; color:#9aa7b5">backdrop-blur</p></Layer>

  <Rect cx="860" cy="300" width="240" height="140" rx="24" fill="#ffffff14" glass="clear, blur 8, tint #a8c8ff55" />
  <Layer cx="860" cy="400" anchor="top"><p style="font-size:26px; color:#9aa7b5">glass 逗号写法</p></Layer>

  <Rect cx="200" cy="760" width="280" height="300" rx="28" fill="#ffffff18" glass="clear" />
  <Rect cx="540" cy="760" width="280" height="300" rx="28" fill="#ffffff18" glass="regular" />
  <Rect cx="860" cy="760" width="280" height="300" rx="28" fill="#ffffff20" glass="thick" />
  <Layer cx="200" cy="940" anchor="top"><p style="font-size:26px; color:#f4f1ea">glass clear</p></Layer>
  <Layer cx="540" cy="940" anchor="top"><p style="font-size:26px; color:#f4f1ea">glass regular</p></Layer>
  <Layer cx="860" cy="940" anchor="top"><p style="font-size:26px; color:#f4f1ea">glass thick</p></Layer>
</Layer>
