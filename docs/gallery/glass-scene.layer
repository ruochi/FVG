<Layer width="780" height="1400" background="#0b0f1a" color="#ffffff" font-family="Kai">
  <!-- 壁纸：大色块 + 大字 + 细条，给折射一些细节 -->
  <Rect x1="0" y1="0" x2="780" y2="1400" fill="linear-gradient(160deg, #1d2b64, #5b2a86 45%, #f0765a 80%, #ffcf7a)" />
  <Circle cx="580" cy="280" r="170" fill="#ff5aa5" opacity="0.85" />
  <Circle cx="200" cy="720" r="160" fill="#2ec4ff" opacity="0.85" />
  <Circle cx="560" cy="1080" r="180" fill="#3ecf8e" opacity="0.8" />
  <Rect x1="0" y1="560" x2="780" y2="572" fill="#ffffff" opacity="0.8" />
  <Rect x1="0" y1="600" x2="780" y2="612" fill="#ffd23f" />
  <Rect x1="0" y1="640" x2="780" y2="652" fill="#ffffff" opacity="0.8" />
  <Rect x1="0" y1="1230" x2="780" y2="1242" fill="#ffffff" opacity="0.8" />
  <Rect x1="0" y1="1270" x2="780" y2="1282" fill="#ffd23f" />
  <Rect x1="0" y1="1310" x2="780" y2="1322" fill="#ffffff" opacity="0.8" />

  <Layer cx="390" cy="200" anchor="center">
    <h1 style="font-size:180px; color:#ffffff">9:41</h1>
  </Layer>
  <Layer cx="390" cy="330" anchor="center">
    <p style="font-size:40px; color:#ffffffcc">九月三十日 星期三</p>
  </Layer>

  <!-- 小组件 -->
  <Rect cx="390" cy="600" width="640" height="220" rx="44" fill="#ffffff00" glass="clear" />
  <Layer cx="130" cy="530" anchor="top-left">
    <p style="font-size:34px; color:#ffffff">天气 · 上海</p>
  </Layer>
  <Layer cx="130" cy="580" anchor="top-left">
    <h1 style="font-size:88px; color:#ffffff">24°</h1>
  </Layer>
  <Layer cx="650" cy="640" anchor="right">
    <p style="font-size:30px; color:#ffffffdd">晴 · 最高 27°</p>
  </Layer>

  <!-- 圆形按钮 -->
  <Circle cx="170" cy="880" r="70" fill="#ffffff00" glass="clear" />
  <Circle cx="390" cy="880" r="70" fill="#ffffff00" glass="clear" />
  <Circle cx="610" cy="880" r="70" fill="#ffffff00" glass="clear" />
  <Layer cx="170" cy="880" anchor="center"><p style="font-size:44px; color:#ffffff">光</p></Layer>
  <Layer cx="390" cy="880" anchor="center"><p style="font-size:44px; color:#ffffff">音</p></Layer>
  <Layer cx="610" cy="880" anchor="center"><p style="font-size:44px; color:#ffffff">锁</p></Layer>

  <!-- 底部 Tab Bar 胶囊 -->
  <Rect cx="390" cy="1276" width="620" height="120" rx="60" fill="#ffffff00" glass="clear" />
  <Layer cx="160" cy="1276" anchor="center"><p style="font-size:32px; color:#ffffff">首页</p></Layer>
  <Layer cx="313" cy="1276" anchor="center"><p style="font-size:32px; color:#ffffffbb">发现</p></Layer>
  <Layer cx="467" cy="1276" anchor="center"><p style="font-size:32px; color:#ffffffbb">消息</p></Layer>
  <Layer cx="620" cy="1276" anchor="center"><p style="font-size:32px; color:#ffffffbb">我的</p></Layer>
</Layer>
