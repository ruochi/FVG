<fvg style="width:800px; height:600px; background:#fff; color:#333">
  <Rect cx="200" cy="200" style="width:160px; height:100px; rx:12px; fill:#f7931a; shadow:0 10px 20px #00000033" />
  <h2 cx="200" cy="200" anchor="center" style="color:#fff; font-size:36px">FVG</h2>
  <Arrow x1="280" y1="200" x2="420" y2="200" style="stroke:#333; stroke-width:6px" />
  <Line x1="100" y1="400" x2="700" y2="400" style="stroke:#ccc; stroke-width:2px" />
</fvg>
