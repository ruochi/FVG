<Layer width="720" height="480" background="#0f1115" color="#f4f1ea">
  <Layer cx="40" cy="36" anchor="top-left">
    <h1 style="font-size:42px">Layer + draw</h1>
  </Layer>
  <Layer cx="40" cy="96" anchor="top-left">
    <p style="font-size:22px; color:#9aa3b2">嵌套 Layer 不填背景，色块用 Rect 或 draw</p>
  </Layer>

  <Rect cx="148" cy="228" width="200" height="120" rx="16" fill="#1c2430" />
  <Layer cx="48" cy="200" anchor="top-left">
    <p style="font-size:20px; color:#9aa3b2">Rect fill</p>
  </Layer>

  <Layer width="200" height="120" cx="396" cy="288">
    <draw>
      const g = ctx.createLinearGradient(0, 0, el.w, el.h)
      g.addColorStop(0, '#3ecfc4')
      g.addColorStop(1, '#2a6cf0')
      ctx.fillStyle = g
      ctx.beginPath()
      const r = 16
      ctx.moveTo(r, 0)
      ctx.arcTo(el.w, 0, el.w, el.h, r)
      ctx.arcTo(el.w, el.h, 0, el.h, r)
      ctx.arcTo(0, el.h, 0, 0, r)
      ctx.arcTo(0, 0, el.w, 0, r)
      ctx.closePath()
      ctx.fill()
      ctx.fillStyle = '#0f1115'
      ctx.font = '20px sans-serif'
      ctx.fillText('draw', 16, 36)
    </draw>
  </Layer>
  <Layer cx="296" cy="200" anchor="top-left">
    <p style="font-size:20px; color:#9aa3b2">draw 渐变块</p>
  </Layer>

  <Layer width="160" height="160" cx="616" cy="288">
    <draw>
      const cx = el.w / 2
      const cy = el.h / 2
      const rays = 16
      for (let i = 0; i < rays; i++) {
        const a0 = (i / rays) * Math.PI * 2
        const a1 = ((i + 0.45) / rays) * Math.PI * 2
        ctx.beginPath()
        ctx.moveTo(cx, cy)
        ctx.arc(cx, cy, 70, a0, a1)
        ctx.closePath()
        ctx.fillStyle = i % 2 === 0 ? '#f5c16c' : '#e8894a'
        ctx.fill()
      }
      ctx.beginPath()
      ctx.arc(cx, cy, 28, 0, Math.PI * 2)
      ctx.fillStyle = '#0f1115'
      ctx.fill()
    </draw>
  </Layer>
</Layer>
