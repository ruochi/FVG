  <p cx="120" cy="470" anchor="center" style="width:48px; font-size:32px; line-height:1.35; color:#f6efe4; text-align:center">十月廿三</p>

  <Rect cx="540" cy="1170" style="width:1080px; height:900px; fill:#f6f1e8; shadow:0 -18px 36px #00000066" />
  <Rect cx="540" cy="728" style="width:1080px; height:8px; fill:#e07a2f" />

  <Column cx="72" cy="768" anchor="top-left" style="width:936px; gap:16px; align-items:start">
