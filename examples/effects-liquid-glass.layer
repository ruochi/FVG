<layer width="780" height="1400" background="#0a0c12" color="#f4f1ea" font-family="Kai">
  <!-- 彩色背景，方便看出透镜折射把背后内容「弯」了 -->
  <rect x1="0" y1="0" x2="780" y2="1400" fill="linear-gradient(to bottom, #1a1040, #0b3d5c 45%, #2a6b4f)" />
  <circle cx="180" cy="280" r="140" fill="#ff5aa5" opacity="0.85" />
  <circle cx="620" cy="360" r="160" fill="#3ecfc4" opacity="0.8" />
  <circle cx="360" cy="720" r="180" fill="#f5c16c" opacity="0.75" />
  <circle cx="560" cy="980" r="150" fill="#7b6cff" opacity="0.8" />
  <rect x1="0" y1="520" x2="780" y2="560" fill="#ffffff" opacity="0.55" />
  <rect x1="120" y1="200" x2="160" y2="1200" fill="#ff9f1c" opacity="0.65" />

  <layer cx="56" cy="56" anchor="top-left">
    <h1 style="font-size:48px; color:#f7f2e8">Liquid Glass</h1>
  </layer>
  <layer cx="56" cy="118" anchor="top-left">
    <p style="font-size:26px; color:#c9d0d8">折射透镜 · 模糊 · 高光</p>
  </layer>

  <!-- 主玻璃卡片：边缘应比中心更「放大」背后条纹 -->
  <rect cx="390" cy="620" width="560" height="340" rx="36"
        fill="#ffffff18" glass="thick" border="1.5 #ffffff77" />

  <layer cx="390" cy="560" anchor="center">
    <h2 style="font-size:56px; color:#ffffff; shadow:0 2 8 #00000055">寒潮预警</h2>
  </layer>
  <layer cx="390" cy="640" anchor="center">
    <p style="font-size:30px; color:#f0f4f8">glass="thick"</p>
  </layer>
  <layer cx="390" cy="700" anchor="center">
    <p style="font-size:26px; color:#d7dee6">边缘折射放大背后色块</p>
  </layer>

  <!-- 胶囊按钮 / 灵动岛感 -->
  <rect cx="240" cy="980" width="220" height="72" rx="36"
        fill="#ffffff20" glass="regular" border="1 #ffffff66" />
  <layer cx="240" cy="980" anchor="center">
    <p style="font-size:28px; color:#ffffff">regular</p>
  </layer>

  <rect cx="540" cy="980" width="220" height="72" rx="36"
        fill="#ffffff14" glass="clear" border="1 #ffffff55" />
  <layer cx="540" cy="980" anchor="center">
    <p style="font-size:28px; color:#ffffff">clear</p>
  </layer>

  <!-- 圆形透镜 -->
  <circle cx="390" cy="1200" r="110" fill="#ffffff16" glass="28 #a8d8ff33" border="1.5 #ffffff88" />
  <layer cx="390" cy="1200" anchor="center">
    <p style="font-size:28px; color:#ffffff">lens</p>
  </layer>
</layer>
