<layer width="900" height="1100" background="#0c1018" color="#f4f1ea" font-family="Kai">
  <rect x1="0" y1="0" x2="900" y2="1100" fill="linear-gradient(to bottom, #141a28, #1e3a4a 50%, #2d4a3e)" />

  <!-- 高对比背景：条纹 + 色块，糊掉后应看不清细节 -->
  <circle cx="220" cy="320" r="160" fill="#ff5aa5" />
  <circle cx="680" cy="380" r="180" fill="#3ecfc4" />
  <circle cx="420" cy="780" r="200" fill="#f5c16c" />
  <rect x1="0" y1="480" x2="900" y2="520" fill="#ffffff" opacity="0.7" />
  <rect x1="0" y1="560" x2="900" y2="580" fill="#ff9f1c" opacity="0.85" />
  <rect x1="0" y1="620" x2="900" y2="640" fill="#7b6cff" opacity="0.8" />
  <rect x1="180" y1="160" x2="230" y2="980" fill="#ffffff" opacity="0.55" />

  <layer cx="64" cy="56" anchor="top-left">
    <h1 style="font-size:52px; color:#f7f2e8">毛玻璃</h1>
  </layer>
  <layer cx="64" cy="120" anchor="top-left">
    <p style="font-size:28px; color:#aeb8c4">glass="thick" · 强模糊 · 弱折射</p>
  </layer>

  <rect cx="450" cy="560" width="620" height="420" rx="40"
        fill="#ffffff22" glass="thick" border="1.5 #ffffff66" />

  <layer cx="450" cy="500" anchor="center">
    <h2 style="font-size:56px; color:#ffffff; shadow:0 2 10 #00000055">磨砂面板</h2>
  </layer>
  <layer cx="450" cy="590" anchor="center">
    <p style="font-size:30px; color:#e8eef4">背后条纹被糊成色晕</p>
  </layer>
  <layer cx="450" cy="660" anchor="center">
    <p style="font-size:26px; color:#c5d0da">细节不可读 · 像 iOS 磨砂材质</p>
  </layer>
</layer>
