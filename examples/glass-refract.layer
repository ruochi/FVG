  <Layer cx="450" cy="420" anchor="center">
    <h1 style="font-size:150px; color:#2b6cff">折射 Aa</h1>
  </Layer>

  <!-- 胶囊按钮盖在大字上 -->
  <Rect cx="450" cy="420" width="560" height="150" rx="75" fill="#ffffff00" glass="clear" />

  <!-- 圆形透镜盖在色条和网格上 -->
  <Circle cx="250" cy="760" r="120" fill="#ffffff00" glass="clear" />

  <!-- 圆角卡片 -->
  <Rect cx="640" cy="820" width="360" height="260" rx="56" fill="#ffffff00" glass="clear" />
  <Layer cx="640" cy="820" anchor="center">
