{
  "name": "@dc/fvg",
  "version": "0.1.0",
  "description": "FVG (Flex Vector Graphics): AI-friendly 2D frame markup with flex layout, HTML text and SVG-style shapes, rendered to PNG",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fvg": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:generate": "vitest run --config generate/vitest.config.ts",
    "fvg": "tsx src/cli.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.19.2",
    "typescript": "~5.4.2",
    "vitest": "^2.1.9"
  }
}
