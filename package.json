{
  "name": "@dc/flexlayer",
  "version": "0.1.0",
  "description": "Code-to-image for AI agents: write .layer markup, render a PNG and a layout report",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    }
  },
  "bin": {
    "flexlayer": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:generate": "vitest run --config generate/vitest.config.ts",
    "pythagoras": "tsx examples/render-pythagoras.ts",
    "flexlayer": "tsx src/cli.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.19.2",
    "typescript": "~5.4.2",
    "vitest": "^2.1.9"
  }
}
